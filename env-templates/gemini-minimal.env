# =============================================================================
# Roost — Gemini Minimal
# Cheapest path to a working agent. Gemini (free tier) + Telegram.
# Everything else is off; enable later via the /settings page.
# =============================================================================

# -- Core --
SESSION_SECRET=CHANGE_ME
WEB_USERNAME=admin
WEB_PASSWORD=CHANGE_ME
HOST=0.0.0.0
PORT=8080

# -- Feature Flags --
AI_ENABLED=true
TELEGRAM_ENABLED=false
GOOGLE_ENABLED=false
GMAIL_ENABLED=false
MS_ENABLED=false
NOTION_ENABLED=false
INFRA_ENABLED=true
SSH_ENABLED=false

# -- Gemini AI --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -- Telegram Bot (flip TELEGRAM_ENABLED=true after filling these in) --
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# -- Access Control --
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
AUTO_PROVISION=true
MULTI_TENANT=false

# -- SSH Access (disabled in minimal mode) --
SSH_PASSWORD=CHANGE_ME

# -- Guardian AI & Safety --
GUARDIAN_ENABLED=false
MAX_COST_PER_RUN=0.50
MAX_DAILY_COST=5.00
AUTONOMY_LEVEL=assisted
PROACTIVE_ENABLED=false
PROACTIVE_RISK_INTERVAL=300
PROACTIVE_CALENDAR_PREP=30
MAX_BACKGROUND_RUNS=3
MAX_BACKGROUND_DURATION=300

# -- Messaging integrations (off) --
WHATSAPP_ENABLED=false
WECHAT_ENABLED=false

# -- Discord Bot (run: python -m roost.adapters.discord_bot) --
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=

# -- Slack Bot (run: python -m roost.adapters.slack_bot) --
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=

# -- Signal Bot (run: python -m roost.adapters.signal_bot) --
SIGNAL_API_URL=
SIGNAL_PHONE_NUMBER=
SIGNAL_ALLOWED_NUMBERS=

# -- Matrix Bot (run: python -m roost.adapters.matrix_bot) --
MATRIX_HOMESERVER=
MATRIX_USER_ID=
MATRIX_ACCESS_TOKEN=
MATRIX_PASSWORD=
MATRIX_ALLOWED_USERS=
