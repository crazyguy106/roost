# =============================================================================
# Roost — Property-Agent Edition (Singapore)
# Laptop install for a CEA-registered salesperson. Ships the Property-Agent
# toolkit (IRAS stamp duty, PDPC DNC scrub, CEA CDD/AML screening, HDB EIP
# RPA) plus the WhatsApp lead-nurture flow fronted by a bundled Chatwoot.
#
# This file is a TEMPLATE. Copy to ./.env and replace each CHANGE_ME. The
# compliance adapters (DNC, CDD) need your own org credentials to go live —
# leave them disabled to run the pages in dry-run / narrate mode.
# =============================================================================

# -- Core --
SESSION_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
WEB_USERNAME=agent
WEB_PASSWORD=CHANGE_ME
HOST=127.0.0.1
PORT=8080

# -- Agent provider --
# Claude CLI: uses your Claude.ai subscription's monthly Agent SDK Credit for
# headless agent runs (Pro $20 / Max-5x $100 / Max-20x $200 as of 2026-06-15) —
# no API key needed; heavy /agentic use beyond it is pay-as-you-go. The
# `claude login --device-auth` you run once lives in ./claude-auth.
# Do NOT set ANTHROPIC_API_KEY here — `claude -p` would use it and silently
# bill API instead of your subscription.
AGENT_PROVIDER=claude_cli
HOST_CLAUDE_DIR=./claude-auth
HOST_GEMINI_DIR=./gemini-auth
HOST_CODEX_DIR=./codex-auth
# CLAUDE_CLI_MCP_CONFIG exposes Roost's MCP tools to the embedded /agentic
# agent (baked into the image at this path; leave as-is — without it the
# agent runs with no tools).
CLAUDE_CLI_MCP_CONFIG=/etc/roost/claude-mcp-config.json
CLAUDE_CLI_BIN=/home/dev/.local/bin/claude
CLAUDE_CLI_PERMISSION_MODE=bypassPermissions
CLAUDE_CLI_TIMEOUT=300

# -- Telegram (operator surface) --
# The agent's notification + approval channel: hot-lead alerts on inbound
# WhatsApp and Guardian draft approvals. Clients never see this bot — they
# reach the agent via WhatsApp (fronted by Chatwoot).
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=CHANGE_ME_AFTER_BOTFATHER
TELEGRAM_ALLOWED_USERS=CHANGE_ME_YOUR_TELEGRAM_USER_ID

# -- AI providers --
# Gemini powers non-agent calls (drafts, summaries). Optional if you only use
# the Claude CLI agent.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# -- Vertical bundles for a property agent --
PROPERTY_AGENT_ENABLED=true
# RPA on: the HDB EIP/SPR quota check runs as a browser RPA flow.
RPA_ENABLED=true
MESSAGING_EXTERNAL_ENABLED=true
CRM_ENABLED=true
LEAD_NURTURE_ENABLED=true
# Bearer secret for the /api/leads inbound webhook (lead_nurture ingress).
# Without it the webhook is unauthenticated — set a random value in prod.
LEAD_WEBHOOK_SECRET=CHANGE_ME
SME_OPS_ENABLED=false
# New leads get the SG property-buyer question pack + property_buyer_intro
# cadence. property | financial_advisor | generic. Overrides settings.yaml
# per-instance, so you can flip editions without a rebuild.
DEFAULT_VERTICAL=property

# -- Property-Agent compliance adapters --
# PDPC DNC Registry (PDPA s.43 / Spam Control Act): scrub SG numbers before
# marketing calls/SMS. Apply for an org account at https://www.dnc.gov.sg/.
# Leave DNC_ENABLED=false to run /property-agent/dnc-scrub in dry-run.
DNC_ENABLED=false
DNC_API_BASE_URL=https://www.dnc.gov.sg/api/v2
DNC_API_KEY=CHANGE_ME
DNC_ORG_ID=CHANGE_ME
# CDD / AML screening (CEA PC 01-21 / 02-23): sanctions / PEP / adverse media.
# Vendor-agnostic; complyadvantage is built. Leave disabled to demo dry-run.
CDD_ENABLED=false
CDD_VENDOR=complyadvantage
CDD_API_KEY=CHANGE_ME
CDD_API_BASE_URL=
CDD_REFRESH_DAYS=30

# -- Operator identity (fills lead-nurture cadence drips: {{agent_name}} etc.) --
# Single-line only — Compose env_file does not expand \n into a newline.
AGENT_NAME=Your Name
AGENT_FIRM=Your Agency
AGENT_SIGNOFF=Your Name, CEA Registered Salesperson
# Your CEA registration number (e.g. R012345A) — shown in property drip sign-offs.
AGENT_CEA_NO=CHANGE_ME_CEA_REG_NO
AGENT_BOOKING_LINK=https://cal.com/your-handle

# -- Web tty sweeper (operator surface) --
# Idle TTL: chat_windows older than this get their tmux window killed (row
# stays for the resume drawer). 360 min keeps a work-day live, cleans overnight.
TTY_IDLE_TTL_MINUTES=360
TTY_MEMORY_PRESSURE_RATIO=0.85

# -- Chatwoot routing (WhatsApp inbound/outbound front-end) --
# When CHATWOOT_ENABLED=true, Roost sends outbound WhatsApp via Chatwoot's API
# and receives inbound from Chatwoot's webhook (one dispatch path, no dedupe).
CHATWOOT_ENABLED=true
CHATWOOT_URL=http://chatwoot:3000
CHATWOOT_API_KEY=CHANGE_ME_AFTER_CHATWOOT_SETUP
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=CHANGE_ME_AFTER_INBOX_CREATED
CHATWOOT_WEBHOOK_SECRET=CHANGE_ME_AFTER_WEBHOOK_CREATED

# -- WhatsApp Cloud API (entered into Chatwoot's inbox setup) --
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME

# -- CRM --
CRM_PROVIDER=attio
ATTIO_API_KEY=CHANGE_ME

# -- Tailscale Funnel (exposes the Chatwoot inbox to the agent's phone) --
TAILSCALE_AUTHKEY=CHANGE_ME

# -- Chatwoot stack secrets (consumed by docker-compose.fa.yml) --
CHATWOOT_POSTGRES_PASSWORD=CHANGE_ME_OPENSSL_RAND_HEX_24
CHATWOOT_SECRET_KEY_BASE=CHANGE_ME_OPENSSL_RAND_HEX_64
CHATWOOT_FRONTEND_URL=CHANGE_ME_TO_TAILSCALE_FUNNEL_URL

# -- Access control --
# Single-user laptop install. Empty ALLOWED_EMAILS skips the OAuth allowlist;
# password login is the only path in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
AUTO_PROVISION=false
MULTI_TENANT=false
