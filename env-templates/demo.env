# =============================================================================
# Roost — Demo / Classroom
# Every feature flag turned on, with placeholder credentials.
# Use for classroom walkthroughs where the instructor shows every screen.
#
# WARNING: do NOT use this in production. The placeholder values are
# insecure defaults so the UI renders everything — nothing will actually
# work until you replace each CHANGE_ME with a real credential.
# =============================================================================

# -- Core --
SESSION_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
WEB_USERNAME=admin
WEB_PASSWORD=CHANGE_ME
HOST=0.0.0.0
PORT=8080

# -- Feature Flags (all on for the tour) --
AI_ENABLED=true
TELEGRAM_ENABLED=true
GOOGLE_ENABLED=true
GMAIL_ENABLED=true
MS_ENABLED=true
NOTION_ENABLED=true
INFRA_ENABLED=true
SSH_ENABLED=true
# Agentic Workflow surface (plan + per-tool event stream at /agentic). Demo: on.
AGENTIC_WORKFLOW_ENABLED=true
# Empty = use AGENT_PROVIDER's executor model. Override here for a cheaper planner.
AGENTIC_PLANNER_MODEL=

# -- AI providers (Gemini is the default) --
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3-flash-preview
CLAUDE_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME

# -- Telegram Bot --
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_ALLOWED_USERS=

# -- Google OAuth (web login) --
# Left blank so the web UI defaults to the username/password login above
# (WEB_USERNAME / WEB_PASSWORD) — no Google account needed to sign in.
# Fill these with real OAuth creds to show a "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_SEND_FROM=you@example.com

# -- Microsoft Graph --
# Blank MS_CLIENT_ID = no "Sign in with Microsoft" button; password login
# stays the default. Fill in to enable Microsoft OAuth + Graph services.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# -- Notion --
NOTION_API_TOKEN=CHANGE_ME

# -- Guardian AI & Safety (all on for the tour) --
GUARDIAN_ENABLED=true
MAX_COST_PER_RUN=0.50
MAX_DAILY_COST=5.00
AUTONOMY_LEVEL=assisted
PROACTIVE_ENABLED=true
PROACTIVE_RISK_INTERVAL=300
PROACTIVE_CALENDAR_PREP=30
MAX_BACKGROUND_RUNS=3
MAX_BACKGROUND_DURATION=300

# -- Vertical bundle master flags (all on for the tour) --
# Each bundle is a self-contained package under roost/extras/<name>/.
# Demo template enables every bundle so the UI renders all routes.
CRM_ENABLED=true
LEAD_NURTURE_ENABLED=true
RPA_ENABLED=true
MESSAGING_EXTERNAL_ENABLED=true
# PROPERTY_AGENT_ENABLED and SME_OPS_ENABLED are set below.

# -- WhatsApp Cloud API --
# Sub-flag under MESSAGING_EXTERNAL_ENABLED.
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME

# -- Chatwoot (FA-edition helpdesk front-end, off in the demo by default) --
CHATWOOT_ENABLED=false
CHATWOOT_URL=
CHATWOOT_API_KEY=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_WEBHOOK_SECRET=

# -- Property-Agent Toolkit (Singapore) — master flag --
PROPERTY_AGENT_ENABLED=true

# -- PDPC DNC Registry (Singapore Do-Not-Call) --
# Required before marketing calls/SMS to SG numbers (21-day scrub validity).
# Apply for an org account at https://www.dnc.gov.sg/.
DNC_ENABLED=false
DNC_API_BASE_URL=https://www.dnc.gov.sg/api/v2
DNC_API_KEY=CHANGE_ME
DNC_ORG_ID=CHANGE_ME

# -- CDD Screening (sanctions / PEP / adverse media) --
# Mandatory for SG property agents under CEA PC 01-21 / 02-23.
# Vendors: complyadvantage (built), acuris / refinitiv (stubbed).
CDD_ENABLED=false
CDD_VENDOR=complyadvantage
CDD_API_KEY=CHANGE_ME
CDD_API_BASE_URL=
CDD_REFRESH_DAYS=30

# -- SME Ops bundle (ERP / integration toolkit) --
# Master flag plus native-adapter sub-flags. All on for the tour so
# /sme/sync-status renders every panel; replace CHANGE_ME with real keys
# to actually move money. Universal Zapier ingress covers the long tail.
SME_OPS_ENABLED=true
ZAPIER_ENABLED=true
ZAPIER_INGRESS_TOKEN=CHANGE_ME
ZAPIER_OUTBOUND_URL=
STRIPE_ENABLED=true
STRIPE_API_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
SHOPIFY_ENABLED=true
SHOPIFY_STORE_DOMAIN=CHANGE_ME
SHOPIFY_ACCESS_TOKEN=CHANGE_ME
SHOPIFY_WEBHOOK_SECRET=CHANGE_ME
XERO_ENABLED=true
XERO_CLIENT_ID=CHANGE_ME
XERO_CLIENT_SECRET=CHANGE_ME

# -- WeChat Official Account --
# Sub-flag under MESSAGING_EXTERNAL_ENABLED.
WECHAT_ENABLED=true
WECHAT_APP_ID=CHANGE_ME
WECHAT_APP_SECRET=CHANGE_ME
WECHAT_TOKEN=CHANGE_ME
WECHAT_ENCODING_AES_KEY=

# -- Access Control --
ALLOWED_EMAILS=
ALLOWED_DOMAINS=example.com
AUTO_PROVISION=true
MULTI_TENANT=false

# -- SSH Access --
SSH_PASSWORD=CHANGE_ME

# ── CRM adapter ────────────────────────────────────────────────────
# Choices: local | attio | hubspot | zoho | salesforce | pipedrive
CRM_PROVIDER=local
# Attio
# ATTIO_API_KEY=
# HubSpot (Private App access token)
# HUBSPOT_ACCESS_TOKEN=
# Zoho CRM (OAuth — refresh token)
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=  # captured automatically by /auth/zoho/start
# ZOHO_REDIRECT_URI=https://your-roost.example.com/auth/zoho/callback
# Salesforce (instance URL + access token)
# SALESFORCE_INSTANCE_URL=
# SALESFORCE_ACCESS_TOKEN=
# Pipedrive (legacy API token)
# PIPEDRIVE_API_TOKEN=
