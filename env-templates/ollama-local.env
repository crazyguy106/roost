# =============================================================================
# Roost — Ollama Local
# Fully offline. No cloud AI calls. Requires Ollama running on the host.
#
# Before using this:
#   1. Install Ollama:  curl -fsSL https://ollama.com/install.sh | sh
#   2. Pull a model:    ollama pull llama3.1
#   3. Make sure Ollama listens on 0.0.0.0 so the Roost container can reach it,
#      or set OLLAMA_URL to the host's LAN IP.
# =============================================================================

# -- Core --
SESSION_SECRET=CHANGE_ME
WEB_USERNAME=admin
WEB_PASSWORD=CHANGE_ME
HOST=0.0.0.0
PORT=8080

# -- Feature Flags --
AI_ENABLED=true
TELEGRAM_ENABLED=false
GOOGLE_ENABLED=false
GMAIL_ENABLED=false
MS_ENABLED=false
NOTION_ENABLED=false
INFRA_ENABLED=true
SSH_ENABLED=false

# -- Ollama (running on the Docker host) --
# "host.docker.internal" works on Docker Desktop; on Linux use the host's
# LAN IP or add "extra_hosts" in docker-compose.yml.
OLLAMA_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1

# NOTE: the AI CDR classifier (inbound message safety) currently calls
# Gemini. If you need fully offline operation, keep WhatsApp/WeChat
# disabled — the rest of Roost works without any network AI.
GEMINI_API_KEY=

# -- Telegram Bot --
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# -- Access Control --
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
AUTO_PROVISION=true
MULTI_TENANT=false

# -- SSH Access --
SSH_PASSWORD=CHANGE_ME

# -- Guardian AI & Safety --
GUARDIAN_ENABLED=false
MAX_COST_PER_RUN=0.50
MAX_DAILY_COST=5.00
AUTONOMY_LEVEL=assisted
PROACTIVE_ENABLED=false
PROACTIVE_RISK_INTERVAL=300
PROACTIVE_CALENDAR_PREP=30
MAX_BACKGROUND_RUNS=3
MAX_BACKGROUND_DURATION=300

# -- Messaging integrations (keep off for fully offline) --
WHATSAPP_ENABLED=false
WECHAT_ENABLED=false
