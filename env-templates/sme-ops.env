# ──────────────────────────────────────────────────────────────────────
# SME Ops vertical bundle
#
# ERP / e-commerce / payments / CRM glue for small-to-medium businesses.
# Phase 0 ships the universal Zapier ingress; native per-app adapters
# (Xero, Shopify, Stripe, HitPay, Lazada, Shopee, HubSpot, Mailchimp,
# Airtable, …) land in Phase 1+.
#
# Copy whichever lines you need into your project root .env.
# ──────────────────────────────────────────────────────────────────────

# Master toggle for the bundle. Off by default — enable to expose
# /sme/* routes and the Zapier ingress endpoint.
SME_OPS_ENABLED=true

# ── Companion bundle flags ────────────────────────────────────────────
# SME Ops works alongside three other bundles that all default to true.
# Listed here so you can flip them off if you only want raw SME adapters
# without lead nurturing or CRM mirroring.
#   CRM_ENABLED                — Attio/Zoho/HubSpot/Pipedrive/Salesforce
#                                /local mirror for SME contacts.
#   LEAD_NURTURE_ENABLED       — outbound cadences against captured leads.
#   MESSAGING_EXTERNAL_ENABLED — WhatsApp/WeChat ingress (with sub-flags
#                                WHATSAPP_ENABLED / WECHAT_ENABLED).
# CRM_ENABLED=true
# LEAD_NURTURE_ENABLED=true
# MESSAGING_EXTERNAL_ENABLED=true

# ── Zapier bridge ─────────────────────────────────────────────────────
# Inbound: bearer-token-protected webhook at POST /api/zapier/inbound.
# Outbound: optional Catch Hook URL Roost can POST to so SOP recipes can
# fan out to any of Zapier's 6,000+ apps.
ZAPIER_ENABLED=true
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ZAPIER_INGRESS_TOKEN=
# Optional — paste a Zapier "Catch Hook" URL here for outbound events.
ZAPIER_OUTBOUND_URL=

# ── Phase 1A native adapters (read-only) ──────────────────────────────
# Stripe — secret key + webhook signing secret. Find both in the Stripe
# dashboard under Developers → API keys / Webhooks.
STRIPE_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Shopify — admin API access token from a custom app (Apps → Develop
# apps → Configure Admin API scopes), and store domain (e.g.
# `mystore.myshopify.com`). Webhook secret from any of the registered
# webhook endpoints.
SHOPIFY_ENABLED=false
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Xero — Two auth paths:
#   (a) OAuth2 (Phase 1B, recommended) — register a "Web app" at
#       https://developer.xero.com/app/manage, copy client id + secret.
#       Visit /api/xero/oauth/start once to connect; tokens persist in
#       the local DB and auto-refresh.
#   (b) Personal Access Token (Phase 1A fallback) — Settings → Connected
#       apps → Personal Access Tokens. Single-user instances only.
# OAuth tokens take precedence over PAT when both are present.
XERO_ENABLED=false
# (a) OAuth2
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional — if unset, Roost derives `https://${ROOST_DOMAIN}/api/xero/oauth/callback`.
XERO_REDIRECT_URI=
# Webhook signing key from the Xero app's Webhooks tab.
XERO_WEBHOOK_KEY=
# (b) PAT fallback
XERO_PAT=
XERO_TENANT_ID=

# ── Phase 2+ adapters ─────────────────────────────────────────────────
# HITPAY_ENABLED=false
# HITPAY_API_KEY=
# HUBSPOT_ENABLED=false
# HUBSPOT_API_KEY=
# MAILCHIMP_ENABLED=false
# MAILCHIMP_API_KEY=
# AIRTABLE_ENABLED=false
# AIRTABLE_API_KEY=
