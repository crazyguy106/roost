# =============================================================================
# Roost — FA (Financial Adviser) Edition
# Laptop install for a solo FA. Inbound + outbound WhatsApp routes through a
# bundled Chatwoot instance; Chatwoot's UI is exposed over Tailscale Funnel
# (free for personal use) so the FA can reach the inbox from their phone.
#
# This file is a TEMPLATE. The install script (scripts/install-fa.sh) copies
# it to ./.env and prompts for each CHANGE_ME. After bring-up the FA still
# needs to:
#   1. Open the Tailscale Funnel URL printed by the installer
#   2. Run Chatwoot's first-boot wizard (admin user + password)
#   3. Generate a Chatwoot API token and create a WhatsApp Cloud-API inbox
#   4. Paste the token + inbox ID back into .env and `docker compose up -d` to
#      restart Roost so it picks up CHATWOOT_API_KEY / CHATWOOT_INBOX_ID
# =============================================================================

# -- Core --
SESSION_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
WEB_USERNAME=fa
WEB_PASSWORD=CHANGE_ME
HOST=127.0.0.1
PORT=8080

# -- Agent provider --
# Default to Claude CLI: uses your Claude.ai subscription's monthly Agent SDK
# Credit for headless agent runs (Pro $20 / Max-5x $100 / Max-20x $200 as of
# 2026-06-15) — no API key needed. Heavy /agentic use beyond that credit falls
# back to pay-as-you-go. Auth lives in ./claude-auth (bind-mounted) so the
# `claude login --device-auth` you run once survives `docker compose pull`.
# Do NOT set ANTHROPIC_API_KEY here — `claude -p` would use it and silently
# bill API instead of your subscription.
AGENT_PROVIDER=claude_cli
HOST_CLAUDE_DIR=./claude-auth
HOST_GEMINI_DIR=./gemini-auth
HOST_CODEX_DIR=./codex-auth
#
# Claude CLI tuning (read only when AGENT_PROVIDER=claude_cli).
# MCP_CONFIG is the important one — it exposes Roost's own MCP tools to the
# embedded /agentic agent. Baked into the image at this path; leave as-is.
# Without it the agent runs with no tools.
CLAUDE_CLI_MCP_CONFIG=/etc/roost/claude-mcp-config.json
CLAUDE_CLI_BIN=/home/dev/.local/bin/claude
# bypassPermissions = agent runs tools without per-call prompts.
# Guardian still gates money-moving + client-message tools regardless.
CLAUDE_CLI_PERMISSION_MODE=bypassPermissions
CLAUDE_CLI_TIMEOUT=300

# -- Telegram (operator surface) --
# ON in FA edition. Telegram is the *adviser's* notification channel — hot-lead
# alerts on inbound WhatsApp, /nlist Guardian draft approvals, and the morning
# brief all ping here. Customers never see this bot; they reach the FA via
# Chatwoot (which fronts WhatsApp / WeChat / Email).
#
#   * TELEGRAM_BOT_TOKEN  — message @BotFather, /newbot, copy the token.
#   * TELEGRAM_ALLOWED_USERS — DM @userinfobot, copy your numeric user id.
#     Comma-separated if more than one adviser shares the laptop.
#
# Both can be left as CHANGE_ME for now; entrypoint.sh logs a warning and skips
# the bot, the rest of the stack still comes up.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=CHANGE_ME_AFTER_BOTFATHER
TELEGRAM_ALLOWED_USERS=CHANGE_ME_YOUR_TELEGRAM_USER_ID

# -- AI providers --
# Gemini is still used for non-agent calls (briefings, summarisation). The FA
# can leave this blank if they're only using the Claude CLI agent.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# -- Vertical bundles for a solo FA --
MESSAGING_EXTERNAL_ENABLED=true
CRM_ENABLED=true
LEAD_NURTURE_ENABLED=true
# Bearer secret for the /api/leads inbound webhook (lead_nurture ingress).
# Without it the webhook is unauthenticated — set a random value in prod.
LEAD_WEBHOOK_SECRET=CHANGE_ME
# Vertical for new leads — which question pack + cadence they get.
# property | financial_advisor | generic. Overrides settings.yaml per-instance,
# so you can flip editions without a rebuild.
DEFAULT_VERTICAL=financial_advisor
RPA_ENABLED=false
SME_OPS_ENABLED=false
PROPERTY_AGENT_ENABLED=false

# -- Operator identity (fills lead-nurture cadence drips: {{agent_name}} etc.) --
# Without these, the day-0/3/7 follow-up messages render with blank name/sign-off.
# Single-line only — Compose env_file does not expand \n into a newline.
AGENT_NAME=Your Name
AGENT_FIRM=Your Firm
AGENT_SIGNOFF=Best regards, Your Name
AGENT_BOOKING_LINK=https://cal.com/your-handle
# AGENT_CEA_NO=          # property-agent only; leave blank for FA

# -- Web tty sweeper (FA-edition operator surface) --
# Idle TTL: chat_windows with last_active_at older than this get their
# tmux window killed (row stays for the resume drawer). 360 minutes
# (6h) keeps a full work-day live and cleans up overnight.
TTY_IDLE_TTL_MINUTES=360
# Memory-pressure threshold. When cgroup v2 reports
# memory.current/memory.max >= this, the sweeper evicts the coldest
# live windows globally. 0.85 leaves 15% headroom before OOM-killer.
TTY_MEMORY_PRESSURE_RATIO=0.85

# -- Chatwoot routing (the heart of the FA edition) --
# When CHATWOOT_ENABLED=true, Roost:
#   * sends outbound WhatsApp via Chatwoot's API (not direct to Meta), so every
#     message lands in the FA's Chatwoot conversation thread automatically
#   * receives inbound from Chatwoot's webhook (not Meta's webhook) so we don't
#     dedupe two incoming streams
CHATWOOT_ENABLED=true
CHATWOOT_URL=http://chatwoot:3000
CHATWOOT_API_KEY=CHANGE_ME_AFTER_CHATWOOT_SETUP
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=CHANGE_ME_AFTER_INBOX_CREATED
# Per-webhook HMAC secret. After creating the webhook in Chatwoot UI
# (Settings > Integrations > Webhooks > Add new), copy its "secret"
# field here. Rotating the secret in Chatwoot means re-pasting it.
CHATWOOT_WEBHOOK_SECRET=CHANGE_ME_AFTER_WEBHOOK_CREATED

# -- WhatsApp Cloud API --
# These credentials are entered into Chatwoot's inbox setup, not consumed by
# Roost directly when CHATWOOT_ENABLED=true. Kept here as documentation of
# what the FA needs from Meta.
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME

# -- CRM (Attio is the FA-edition default) --
CRM_PROVIDER=attio
ATTIO_API_KEY=CHANGE_ME

# -- Tailscale Funnel --
# Generate an auth key with the `tag:fa-laptop` ACL tag at
# https://login.tailscale.com/admin/settings/keys. Funnel is free for personal
# accounts.
TAILSCALE_AUTHKEY=CHANGE_ME

# -- Chatwoot stack secrets (consumed by docker-compose.fa.yml) --
# Pre-shared between chatwoot, chatwoot-worker, and chatwoot-postgres. Once
# set, do NOT rotate without dumping + reloading the DB.
CHATWOOT_POSTGRES_PASSWORD=CHANGE_ME_OPENSSL_RAND_HEX_24
CHATWOOT_SECRET_KEY_BASE=CHANGE_ME_OPENSSL_RAND_HEX_64
# Frontend URL = the Tailscale Funnel URL the installer prints on first boot.
# Required so OAuth redirects + the Meta WhatsApp webhook URL Chatwoot
# generates point at the public address (Funnel hostname), not localhost.
CHATWOOT_FRONTEND_URL=CHANGE_ME_TO_TAILSCALE_FUNNEL_URL

# -- Access control --
# Single-user laptop install. Empty ALLOWED_EMAILS skips OAuth allowlist
# checks; password login is the only path in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
AUTO_PROVISION=false
MULTI_TENANT=false
