# =============================================================================
# Roost — Claude Full Stack
# Claude API + Telegram + Google Workspace OAuth + WhatsApp/WeChat messaging.
# Assumes you have a Claude Pro subscription / API credits.
# =============================================================================

# -- Core --
SESSION_SECRET=CHANGE_ME
WEB_USERNAME=admin
WEB_PASSWORD=CHANGE_ME
HOST=0.0.0.0
PORT=8080

# -- Feature Flags --
AI_ENABLED=true
TELEGRAM_ENABLED=true
GOOGLE_ENABLED=true
GMAIL_ENABLED=true
MS_ENABLED=false
NOTION_ENABLED=false
INFRA_ENABLED=true
SSH_ENABLED=true

# -- Claude AI --
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=

# Gemini is still used internally for AI CDR classification (the tool-less
# sandbox that inspects inbound messages). Leave AI_ENABLED=true even if
# you only want Claude as your main agent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -- Google OAuth --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_SEND_FROM=

# -- Telegram Bot --
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# -- Guardian AI & Safety --
GUARDIAN_ENABLED=false
MAX_COST_PER_RUN=0.50
MAX_DAILY_COST=5.00
AUTONOMY_LEVEL=assisted
PROACTIVE_ENABLED=false
PROACTIVE_RISK_INTERVAL=300
PROACTIVE_CALENDAR_PREP=30
MAX_BACKGROUND_RUNS=3
MAX_BACKGROUND_DURATION=300

# -- WhatsApp Cloud API --
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=

# -- Property-Agent Toolkit (Singapore) — master flag --
PROPERTY_AGENT_ENABLED=true

# -- PDPC DNC Registry (Singapore Do-Not-Call) --
DNC_ENABLED=false
DNC_API_BASE_URL=https://www.dnc.gov.sg/api/v2
DNC_API_KEY=
DNC_ORG_ID=

# -- CDD Screening (sanctions / PEP / adverse media) --
CDD_ENABLED=false
CDD_VENDOR=complyadvantage
CDD_API_KEY=
CDD_API_BASE_URL=
CDD_REFRESH_DAYS=30

# -- WeChat Official Account --
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# -- Access Control --
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
AUTO_PROVISION=true
MULTI_TENANT=false

# -- SSH Access --
SSH_PASSWORD=CHANGE_ME

# ── CRM adapter ────────────────────────────────────────────────────
# Choices: local | attio | hubspot | zoho | salesforce | pipedrive
CRM_PROVIDER=local
# Attio
# ATTIO_API_KEY=
# HubSpot (Private App access token)
# HUBSPOT_ACCESS_TOKEN=
# Zoho CRM (OAuth — refresh token)
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=  # captured automatically by /auth/zoho/start
# ZOHO_REDIRECT_URI=https://your-roost.example.com/auth/zoho/callback
# Salesforce (instance URL + access token)
# SALESFORCE_INSTANCE_URL=
# SALESFORCE_ACCESS_TOKEN=
# Pipedrive (legacy API token)
# PIPEDRIVE_API_TOKEN=
