# =============================================================================
# Roost — Claude Full Stack
# Claude (API or Code CLI subscription) + Telegram + Google Workspace OAuth
# + WhatsApp/WeChat messaging.
#
# Two ways to run Claude:
#   AGENT_PROVIDER=claude       → Anthropic API (set CLAUDE_API_KEY)
#   AGENT_PROVIDER=claude_cli   → Claude Code CLI, bills against your
#                                  subscription via ~/.claude/ auth state
#                                  (no API key needed; run `docker compose
#                                   exec roost claude login` once)
# =============================================================================

# -- Core --
SESSION_SECRET=CHANGE_ME
WEB_USERNAME=admin
WEB_PASSWORD=CHANGE_ME
HOST=0.0.0.0
PORT=8080

# Demo magic-link bypass (optional). When set, visiting any URL with
# ?demo=<this-token> mints a session cookie as owner. Leave blank in
# production. Treat the value like a password.
# DEMO_ACCESS_TOKEN=

# -- Feature Flags --
AI_ENABLED=true
TELEGRAM_ENABLED=true
GOOGLE_ENABLED=true
GMAIL_ENABLED=true
MS_ENABLED=false
NOTION_ENABLED=false
INFRA_ENABLED=true
SSH_ENABLED=true
# Agentic Workflow surface (plan + per-tool event stream at /agentic).
# Off by default; flip on after reading docs/agentic-workflow-phase1.md.
AGENTIC_WORKFLOW_ENABLED=false
# Optional planner-model override. Empty = use AGENT_PROVIDER's executor model.
AGENTIC_PLANNER_MODEL=

# -- Agent provider --
# claude     = Anthropic API (needs CLAUDE_API_KEY)
# claude_cli = Claude Code CLI subprocess (uses ~/.claude/ subscription auth)
# gemini_cli = Gemini CLI subprocess (uses ~/.gemini/ OAuth or GEMINI_API_KEY)
# codex_cli  = OpenAI Codex CLI subprocess (uses ~/.codex/ login) — SCAFFOLD,
#              parser is best-effort; verify schema after `codex login`.
# Default for this template = claude_cli (cheapest if you already pay Pro/Max).
AGENT_PROVIDER=claude_cli

# -- Claude AI (API mode) --
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=

# -- Claude Code CLI (subscription mode) --
# Only used when AGENT_PROVIDER=claude_cli. The CLI auth lives in ~/.claude/
# inside the container, persisted via HOST_CLAUDE_DIR bind-mount.
# Default points at the native build under /home/dev/.local/bin (baked by
# Dockerfile via `claude install stable`). The npm-global `claude` on
# PATH remains as a fallback if the native install ever fails.
CLAUDE_CLI_BIN=/home/dev/.local/bin/claude
CLAUDE_CLI_MODEL=
# Path to MCP config exposed to the CLI subprocess. The Roost image bakes
# /etc/roost/claude-mcp-config.json which registers the `roost-mcp` server
# so the CLI can call Roost's 270+ MCP tools (create_task, search_emails,
# attio_*, etc.). Empty = built-in Claude Code tools only.
CLAUDE_CLI_MCP_CONFIG=/etc/roost/claude-mcp-config.json
CLAUDE_CLI_PERMISSION_MODE=bypassPermissions
CLAUDE_CLI_TIMEOUT=300
# Host directory bind-mounted to /home/dev/.claude in the container.
# Default ./claude-auth (created on first compose up). Change to an
# absolute path if you want to share auth across deployments.
HOST_CLAUDE_DIR=./claude-auth

# -- Gemini CLI (subscription mode) --
# Only used when AGENT_PROVIDER=gemini_cli. Auth lives in ~/.gemini/
# (run `docker compose exec roost gemini /auth` once) or via GEMINI_API_KEY.
# MCP wiring: the image bakes /etc/roost/gemini-settings.json and
# entrypoint.sh seeds it into ~/.gemini/settings.json on first boot, so
# Gemini sees the `roost-mcp` server alongside its built-in tools.
GEMINI_CLI_BIN=gemini
GEMINI_CLI_MODEL=
GEMINI_CLI_PERMISSION_MODE=yolo
GEMINI_CLI_TIMEOUT=300
HOST_GEMINI_DIR=./gemini-auth

# -- Codex CLI (subscription mode) — SCAFFOLD --
# Only used when AGENT_PROVIDER=codex_cli. Auth lives in ~/.codex/ (run
# `docker compose exec roost codex login` once). MCP wiring: entrypoint.sh
# seeds ~/.codex/config.toml from /etc/roost/codex-config.toml on first
# boot. Marked SCAFFOLD because the JSON event parser was written from
# docs/issue tracker, not validated end-to-end — schema mismatches show
# up as "Codex error: ..." messages, not silent failures.
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=
CODEX_CLI_PERMISSION_MODE=full-auto
CODEX_CLI_TIMEOUT=300
HOST_CODEX_DIR=./codex-auth

# Gemini is still used internally for AI CDR classification (the tool-less
# sandbox that inspects inbound messages). Leave AI_ENABLED=true even if
# you only want Claude as your main agent. GEMINI_API_KEY also satisfies
# the Gemini CLI when AGENT_PROVIDER=gemini_cli (skips the OAuth flow).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# -- Google OAuth --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_SEND_FROM=

# -- Telegram Bot --
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# -- Guardian AI & Safety --
GUARDIAN_ENABLED=false
MAX_COST_PER_RUN=0.50
MAX_DAILY_COST=5.00
AUTONOMY_LEVEL=assisted
PROACTIVE_ENABLED=false
PROACTIVE_RISK_INTERVAL=300
PROACTIVE_CALENDAR_PREP=30
MAX_BACKGROUND_RUNS=3
MAX_BACKGROUND_DURATION=300

# -- Vertical bundle master flags --
# Each bundle is a self-contained package under roost/extras/<name>/ that
# adds its own services, MCP tools, and web routes. Setting a flag to
# false disables the bundle entirely (zero MCP tools, zero web routes).
# All default to true; only flip off if you want a leaner deployment.
CRM_ENABLED=true
LEAD_NURTURE_ENABLED=true
RPA_ENABLED=true
MESSAGING_EXTERNAL_ENABLED=true
# PROPERTY_AGENT_ENABLED is set below (with its sub-flags).
# SME_OPS_ENABLED defaults to false — see env-templates/sme-ops.env.

# -- WhatsApp Cloud API --
# Sub-flag under MESSAGING_EXTERNAL_ENABLED. Both must be true for the
# WhatsApp adapter and /api/whatsapp/* routes to mount.
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=

# -- Property-Agent Toolkit (Singapore) — master flag --
PROPERTY_AGENT_ENABLED=true

# -- PDPC DNC Registry (Singapore Do-Not-Call) --
DNC_ENABLED=false
DNC_API_BASE_URL=https://www.dnc.gov.sg/api/v2
DNC_API_KEY=
DNC_ORG_ID=

# -- CDD Screening (sanctions / PEP / adverse media) --
CDD_ENABLED=false
CDD_VENDOR=complyadvantage
CDD_API_KEY=
CDD_API_BASE_URL=
CDD_REFRESH_DAYS=30

# -- WeChat Official Account --
# Sub-flag under MESSAGING_EXTERNAL_ENABLED. Both must be true for the
# WeChat adapter and /api/wechat/* routes to mount.
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=

# -- Access Control --
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
AUTO_PROVISION=true
MULTI_TENANT=false

# -- SSH Access --
SSH_PASSWORD=CHANGE_ME

# ── CRM adapter ────────────────────────────────────────────────────
# Choices: local | attio | hubspot | zoho | salesforce | pipedrive
CRM_PROVIDER=local
# Attio
# ATTIO_API_KEY=
# HubSpot (Private App access token)
# HUBSPOT_ACCESS_TOKEN=
# Zoho CRM (OAuth — refresh token)
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=  # captured automatically by /auth/zoho/start
# ZOHO_REDIRECT_URI=https://your-roost.example.com/auth/zoho/callback
# Salesforce (instance URL + access token)
# SALESFORCE_INSTANCE_URL=
# SALESFORCE_ACCESS_TOKEN=
# Pipedrive (legacy API token)
# PIPEDRIVE_API_TOKEN=
