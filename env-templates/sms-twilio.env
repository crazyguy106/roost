# ──────────────────────────────────────────────────────────────────────
# SMS — Twilio outbound
#
# Drives the `sms` channel in lead-nurture cadences. Inbound SMS is not
# wired (Twilio webhooks would land at a future /api/sms/webhook).
#
# Copy whichever lines you need into your project root .env.
# ──────────────────────────────────────────────────────────────────────

# Master toggle. Off by default — adapter fails closed when this is
# false, returning {ok: false, error: "SMS not enabled"} so cadences
# that point at sms rows surface a clear error rather than going dark.
SMS_ENABLED=true

# Provider — only `twilio` is implemented today. Left as a switch so
# alternate carriers (MessageBird, Vonage, AWS SNS) can slot in later
# without touching the dispatch layer.
SMS_PROVIDER=twilio

# ── Twilio credentials ────────────────────────────────────────────────
# Pulled from console.twilio.com → Account → API keys & tokens.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here

# The verified sending number (E.164 format) or a Messaging Service SID.
# E.164 is the common case: TWILIO_FROM_NUMBER=+15551234567
TWILIO_FROM_NUMBER=+15551234567
