# Public VPS deployment — Caddy overlay (docker-compose.public.yml)
# ----------------------------------------------------------------
# Layered on top of any model template (claude-full / openai / etc).
# When this is used, run with:
#   docker compose -f docker-compose.yml -f docker-compose.public.yml up -d

# DNS A record for this domain must point at this VPS's public IP.
ROOST_DOMAIN=roost.example.com

# Used as the Let's Encrypt account email (renewal reminders go here).
ROOST_ADMIN_EMAIL=you@example.com

# Optional — only set if you want to also receive Telegram-side
# notifications about deploy issues (otherwise leave the existing
# TELEGRAM_* vars from your model template).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=

# Note: SIDECAR_PUBLIC_URL is set automatically by the public overlay
# to https://${ROOST_DOMAIN}/sidecar — no need to set it here.
