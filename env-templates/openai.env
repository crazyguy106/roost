# =============================================================================
# Roost — OpenAI
# OpenAI API + Telegram. Use if you pay for ChatGPT Pro / OpenAI credits.
# =============================================================================

# -- Core --
SESSION_SECRET=CHANGE_ME
WEB_USERNAME=admin
WEB_PASSWORD=CHANGE_ME
HOST=0.0.0.0
PORT=8080

# -- Feature Flags --
AI_ENABLED=true
TELEGRAM_ENABLED=false
GOOGLE_ENABLED=false
GMAIL_ENABLED=false
MS_ENABLED=false
NOTION_ENABLED=false
INFRA_ENABLED=true
SSH_ENABLED=false

# -- OpenAI --
OPENAI_API_KEY=

# Gemini key is still needed for the AI CDR classifier (tool-less sandbox
# that inspects inbound messages before any real tool runs). Free tier is
# fine — it only processes small text snippets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# -- Telegram Bot --
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# -- Access Control --
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
AUTO_PROVISION=true
MULTI_TENANT=false

# -- SSH Access --
SSH_PASSWORD=CHANGE_ME

# -- Guardian AI & Safety --
GUARDIAN_ENABLED=false
MAX_COST_PER_RUN=0.50
MAX_DAILY_COST=5.00
AUTONOMY_LEVEL=assisted
PROACTIVE_ENABLED=false
PROACTIVE_RISK_INTERVAL=300
PROACTIVE_CALENDAR_PREP=30
MAX_BACKGROUND_RUNS=3
MAX_BACKGROUND_DURATION=300

# -- Messaging integrations (off) --
WHATSAPP_ENABLED=false
WECHAT_ENABLED=false
